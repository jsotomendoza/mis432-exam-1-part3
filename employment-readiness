    opts:[
      {l:'A',title:'Capstone + Certifications',          body:'Complete a real-world capstone with measurable impact and earn two industry certs (AWS, Google Analytics, PMP, CPA…).',      ip:'High Impact',ic:'ip-h',score:95},
      {l:'B',title:'Part-time Internship or Freelancing',body:'Land a part-time internship or take on three freelance projects. Build a portfolio of real deliverables to show employers.',  ip:'High Impact',ic:'ip-h',score:90},
      {l:'C',title:'Online Courses (Coursera / Udemy)',  body:'Complete 4+ online courses in your target skills — Python, Excel modelling, UX, finance. Add the certificates to LinkedIn.',  ip:'Medium Impact',ic:'ip-m',score:63},
      {l:'D',title:'Rely on Your Degree Alone',          body:'Assume your GPA and diploma are enough. Spend senior year on campus life with no new skills, projects, or certifications.',   ip:'Low Impact',ic:'ip-l',score:18},
    ]
  }
];

// ─────────────────────────────────────
//  STATE
// ─────────────────────────────────────
let ST = { name:'', major:'', choices:{}, scores:{} };
let idx = 0;

function majorLabel(m) {
  return {cs:'Computer Science',business:'Business / Finance',engineering:'Engineering',liberal:'Liberal Arts / Design'}[m] || m;
}

// ─────────────────────────────────────
//  SCREEN SWITCHER — dead simple
// ─────────────────────────────────────
function show(id) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('show'));
  const el = document.getElementById(id);
  void el.offsetWidth;          // reflow so animation re-fires
  el.classList.add('show');
  window.scrollTo(0, 0);
}

// ─────────────────────────────────────
//  LANDING
// ─────────────────────────────────────
function goSetup() { show('s-setup'); }

// ─────────────────────────────────────
//  SETUP
// ─────────────────────────────────────
function pickMajor(card) {
  document.querySelectorAll('.major-card').forEach(c => c.classList.remove('picked'));
  card.classList.add('picked');
  ST.major = card.dataset.major;
  document.getElementById('begin-btn').classList.remove('off');
}

function beginSim() {
  if (!ST.major) return;
  ST.name    = document.getElementById('inp-name').value.trim() || 'Student';
  ST.choices = {};
  ST.scores  = {};
  idx        = 0;

  document.getElementById('tb-name').textContent = ST.name;
  document.getElementById('tb-meta').textContent = majorLabel(ST.major) + ' · Senior Year';

  show('s-decisions');
  renderCat('r');
}

// ─────────────────────────────────────
//  DECISIONS
// ─────────────────────────────────────
function renderCat(dir) {
  const cat    = CATS[idx];
  const chosen = (ST.choices[cat.id] !== undefined) ? ST.choices[cat.id] : -1;

  // progress
  document.getElementById('prog-fill').style.width = (idx / CATS.length * 100) + '%';
  document.getElementById('step-lbl').textContent  = 'Category ' + (idx + 1) + ' of ' + CATS.length;

  // back button
  document.getElementById('back-btn').style.display = idx > 0 ? 'inline-flex' : 'none';

  // next button state
  const nb = document.getElementById('next-btn');
  nb.textContent = (idx === CATS.length - 1) ? 'See My Results →' : 'Next →';
  if (chosen >= 0) nb.classList.remove('off'); else nb.classList.add('off');

  // mini pills (already-answered categories)
  document.getElementById('mini-pills').innerHTML = CATS.slice(0, idx).map(c =>
    '<div class="mini-pill">' +
      '<div class="mini-pill-val" style="color:' + c.color + '">' + (ST.scores[c.id] || 0) + '</div>' +
      '<div class="mini-pill-lbl">' + c.title.split(' ')[0] + '</div>' +
    '</div>'
  ).join('');

  const animCls = dir === 'r' ? 'anim-r' : dir === 'l' ? 'anim-l' : '';

  const optsHTML = cat.opts.map(function(o, i) {
    return '<div class="opt-card' + (chosen === i ? ' chosen' : '') + '" style="--oc:' + cat.color + '" onclick="choose(' + i + ')">' +
      '<div class="opt-letter">' + o.l + '</div>' +
      '<h4>' + o.title + '</h4>' +
      '<p>' + o.body + '</p>' +
      '<span class="ip ' + o.ic + '">' + o.ip + '</span>' +
    '</div>';
  }).join('');

  document.getElementById('q-area').innerHTML =
    '<div class="' + animCls + '">' +
      '<div class="cat-header">' +
        '<div class="cat-icon-box" style="background:' + cat.bg + '">' + cat.icon + '</div>' +
        '<div><div class="cat-title">' + cat.title + '</div><div class="cat-desc">' + cat.desc + '</div></div>' +
      '</div>' +
      '<p class="q-text">' + cat.q + '</p>' +
      '<div class="opts-grid">' + optsHTML + '</div>' +
    '</div>';
}

function choose(i) {
  const cat = CATS[idx];
  ST.choices[cat.id] = i;
  ST.scores[cat.id]  = cat.opts[i].score;
  renderCat('');   // no slide — just update selection
}

function nextCat() {
  if (idx < CATS.length - 1) {
    idx++;
    renderCat('r');
    window.scrollTo(0, 0);
  } else {
    buildResults();
    show('s-results');
    setTimeout(function() {
      CATS.forEach(function(c) {
        var el = document.getElementById('bar-' + c.id);
        if (el) el.style.width = (ST.scores[c.id] || 0) + '%';
      });
    }, 400);
  }
}

function prevCat() {
  if (idx > 0) { idx--; renderCat('l'); window.scrollTo(0, 0); }
}

// ─────────────────────────────────────
//  RESULTS
// ─────────────────────────────────────
function buildResults() {
  const scores = CATS.map(function(c){ return ST.scores[c.id] || 0; });
  const avg    = Math.round(scores.reduce(function(a,b){return a+b;}, 0) / scores.length);
  const name   = ST.name;

  const scoreEl = document.getElementById('r-score');
  scoreEl.textContent = avg;
  scoreEl.style.color = avg >= 85 ? '#00e5a0' : avg >= 65 ? '#3b82f6' : avg >= 45 ? '#f59e0b' : '#ef4444';

  const pill    = document.getElementById('r-pill');
  const verdict = document.getElementById('r-verdict');

  if (avg >= 85) {
    pill.textContent   = '🏆 Highly Prepared';
    pill.style.cssText = 'background:rgba(0,229,160,.12);color:#00e5a0';
    verdict.textContent = name + ", you've done the work. Your investment across all four pillars puts you well ahead of your graduating class. Employers will feel it from the first interview.";
  } else if (avg >= 65) {
    pill.textContent   = '📈 Moderately Prepared';
    pill.style.cssText = 'background:rgba(59,130,246,.12);color:#3b82f6';
    verdict.textContent = name + ", you're on the right track but there are gaps. Target the lower-scoring areas now to significantly improve your hiring odds before graduation.";
  } else if (avg >= 45) {
    pill.textContent   = '⚠️ Partially Prepared';
    pill.style.cssText = 'background:rgba(245,158,11,.12);color:#f59e0b';
    verdict.textContent = name + ", some foundations are in place but critical steps are missing. Take targeted action in the next 90 days — you still have time to close the gap.";
  } else {
    pill.textContent   = '🚨 Underprepared';
    pill.style.cssText = 'background:rgba(239,68,68,.12);color:#ef4444';
    verdict.textContent = name + ", based on these choices you are at significant risk of a long search after graduation. The good news: immediate changes will compound quickly.";
  }

  // breakdown cards
  document.getElementById('r-breakdown').innerHTML = CATS.map(function(c) {
    const s     = ST.scores[c.id] || 0;
    const cIdx  = ST.choices[c.id] !== undefined ? ST.choices[c.id] : 0;
    const cName = c.opts[cIdx].title;
    return '<div class="b-card">' +
      '<div class="b-top"><span class="b-icon">' + c.icon + '</span>' +
      '<div><div class="b-name">' + c.title + '</div><div class="b-choice">Choice: ' + cName + '</div></div></div>' +
      '<div class="bar-bg"><div class="bar-fg" id="bar-' + c.id + '" style="background:' + c.color + '"></div></div>' +
      '<div class="bar-lbl"><span>Readiness</span><strong style="color:' + c.color + '">' + s + '/100</strong></div>' +
    '</div>';
  }).join('');

  // outcome
  const ob = document.getElementById('r-outcome');
  const ot = document.getElementById('r-ot');
  const op = document.getElementById('r-op');
  if (avg >= 85) {
    ob.style.cssText = 'background:rgba(0,229,160,.05);border:1px solid rgba(0,229,160,.18)';
    ot.textContent   = '🎉 Outcome: Multiple Offers at Graduation';
    op.textContent   = name + ' graduates with 2–3 job offers in hand. Their targeted approach — polished resume, confident interviews, strong network, and tangible skills — made them a standout candidate. Starting salary runs 15–25% above peers who did not prepare. Within two years they are promoted ahead of their cohort.';
  } else if (avg >= 65) {
    ob.style.cssText = 'background:rgba(59,130,246,.05);border:1px solid rgba(59,130,246,.18)';
    ot.textContent   = '📬 Outcome: One Offer Within 60 Days of Graduation';
    op.textContent   = name + ' graduates and, after a 6–8 week search, secures one solid offer. The preparation gaps caused some rejections along the way, but they land on their feet. By year two they have levelled up and are competitive for promotions.';
  } else if (avg >= 45) {
    ob.style.cssText = 'background:rgba(245,158,11,.05);border:1px solid rgba(245,158,11,.18)';
    ot.textContent   = '⏳ Outcome: Job Search Extends 4–6 Months';
    op.textContent   = name + ' graduates without an offer and spends several months searching. Repeated rejections expose the gaps in resume quality and interview performance. A role eventually comes — but it is below their potential. Catching up requires time and deliberate self-investment.';
  } else {
    ob.style.cssText = 'background:rgba(239,68,68,.05);border:1px solid rgba(239,68,68,.18)';
    ot.textContent   = '😰 Outcome: Unemployment or Underemployment After Graduation';
    op.textContent   = name + ' graduates unprepared and faces a long, frustrating job search. Six months out they take a role well below their education level just to generate income. Career trajectory is set back 1–2 years, compounding financial and emotional stress.';
  }

  // timeline
  const TL = {
    high:[
      {done:true, t:'Graduation Day',           d: name + ' walks across the stage with confidence — final-round interviews are already in progress.'},
      {done:true, t:'Week 1–2: Final Rounds',   d:'Complete interviews at 3 target companies. Leverage your prep, portfolio, and network connections.'},
      {next:true, t:'Week 3: Offer Negotiation',d:'Receive and negotiate your offer. Use market data to push salary 10–15% above the initial number.'},
      {           t:'Month 2: Day One',          d:'Start your new role with a 30/60/90-day plan already written. Make an early, visible impact.'},
    ],
    medium:[
      {done:true, t:'Graduation Day',              d: name + ' graduates with a few applications in-flight but nothing confirmed yet.'},
      {next:true, t:'Week 1–4: Active Search',     d:'Send 20–30 targeted applications. Return to your career centre for follow-up support and referrals.'},
      {           t:'Week 5–8: Interviews Begin',  d:'First-round invitations start arriving. Prep intensively for every stage.'},
      {           t:'Month 2–3: First Offer',      d:'Land your first offer. Evaluate the fit and negotiate where you can.'},
    ],
    low:[
      {done:true, t:'Graduation Day',              d: name + ' graduates with no active pipeline. The search starts today.'},
      {next:true, t:'Immediate: Build the Base',   d:'Rebuild your resume with career-centre help, refresh LinkedIn, and book 5 alumni informational interviews.'},
      {           t:'Month 2–3: Certify',          d:'Complete one focused certification in your highest-demand skill area (coding, analytics, design, finance).'},
      {           t:'Month 4–6: Target Role',      d:'With improved assets, land an entry-level role. Treat it as a launchpad — not a ceiling.'},
    ]
  };
  const key = avg >= 75 ? 'high' : avg >= 50 ? 'medium' : 'low';
  document.getElementById('r-tl').innerHTML = TL[key].map(function(s, i) {
    const cls = s.done ? 'done' : s.next ? 'next' : '';
    const dot = s.done ? '✓' : s.next ? '→' : (i + 1);
    return '<div class="tl-step ' + cls + '">' +
      '<div class="tl-dot">' + dot + '</div>' +
      '<div class="tl-body"><h4>' + s.t + '</h4><p>' + s.d + '</p></div>' +
    '</div>';
  }).join('');
}

function restart() {
  ST = { name:'', major:'', choices:{}, scores:{} };
  idx = 0;
  document.getElementById('inp-name').value = '';
  document.querySelectorAll('.major-card').forEach(function(c){ c.classList.remove('picked'); });
  document.getElementById('begin-btn').classList.add('off');
  show('s-landing');
}
</script>
</body>
</html>
