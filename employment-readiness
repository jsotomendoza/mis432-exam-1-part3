<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GradReady — Employment Readiness Simulator</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #080c18;
  --surface: #0f1624;
  --surface2: #16202f;
  --border: #1c2a3f;
  --accent: #00e5a0;
  --blue: #3b82f6;
  --amber: #f59e0b;
  --pink: #ec4899;
  --text: #e2e8f4;
  --muted: #5a6a88;
  --radius: 10px;
}
*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
html { scroll-behavior:smooth; }
body {
  background:var(--bg);
  color:var(--text);
  font-family:'DM Sans',sans-serif;
  min-height:100vh;
  overflow-x:hidden;
}
body::after {
  content:'';
  position:fixed;inset:0;
  background-image:
    linear-gradient(rgba(0,229,160,.025) 1px,transparent 1px),
    linear-gradient(90deg,rgba(0,229,160,.025) 1px,transparent 1px);
  background-size:44px 44px;
  pointer-events:none;
  z-index:0;
}

/* ── SCREENS ── */
.screen { display:none; position:relative; z-index:1; }
.screen.show { display:flex; animation:fadeIn .35s ease both; }
#s-landing.show,#s-setup.show {
  flex-direction:column; align-items:center;
  justify-content:center; min-height:100vh;
  padding:48px 20px; text-align:center;
}
#s-decisions.show,#s-results.show {
  flex-direction:column; align-items:stretch; min-height:100vh;
}
@keyframes fadeIn { from{opacity:0;transform:translateY(10px)} to{opacity:1;transform:translateY(0)} }

/* ── TYPE ── */
.hero-title {
  font-family:'Syne',sans-serif;
  font-size:clamp(52px,9vw,100px);
  font-weight:800; line-height:.93;
  letter-spacing:-.03em; margin-bottom:20px;
}
.hero-title em { font-style:normal; color:var(--accent); }
.hero-sub {
  font-size:clamp(15px,2vw,19px); color:var(--muted);
  max-width:500px; line-height:1.65; margin-bottom:48px;
}
.sec-tag {
  font-size:11px; text-transform:uppercase;
  letter-spacing:.15em; color:var(--accent); margin-bottom:10px;
}
.sec-title {
  font-family:'Syne',sans-serif;
  font-size:clamp(24px,4vw,44px);
  font-weight:800; letter-spacing:-.02em; margin-bottom:8px;
}

/* ── BADGE ── */
.live-badge {
  display:inline-flex; align-items:center; gap:8px;
  background:rgba(0,229,160,.09); border:1px solid rgba(0,229,160,.25);
  border-radius:100px; padding:6px 18px; font-size:11px;
  color:var(--accent); letter-spacing:.1em; text-transform:uppercase;
  margin-bottom:36px;
}
.live-badge::before {
  content:''; width:7px; height:7px; border-radius:50%;
  background:var(--accent); animation:blink 1.6s infinite;
}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.2}}

/* ── STATS ── */
.stats-row { display:flex; gap:44px; margin-bottom:52px; }
.stat-num {
  font-family:'Syne',sans-serif; font-size:38px;
  font-weight:800; color:var(--accent); line-height:1;
}
.stat-label { font-size:11px; color:var(--muted); text-transform:uppercase; letter-spacing:.07em; margin-top:4px; }

/* ── BUTTONS ── */
.btn {
  display:inline-flex; align-items:center; gap:10px;
  font-family:'Syne',sans-serif; font-weight:700;
  font-size:15px; padding:16px 36px; border-radius:6px;
  border:none; cursor:pointer; transition:all .18s ease;
  letter-spacing:.02em;
}
.btn-green { background:var(--accent); color:#060a12; }
.btn-green:hover { background:#00ffb2; transform:translateY(-2px); box-shadow:0 10px 36px rgba(0,229,160,.28); }
.btn-outline {
  background:transparent; color:var(--text);
  border:1px solid var(--border);
  font-family:'DM Sans',sans-serif; font-weight:500;
  font-size:14px; padding:12px 22px;
}
.btn-outline:hover { border-color:var(--accent); color:var(--accent); }
.btn.off { opacity:.35; pointer-events:none; cursor:not-allowed; }

/* ── MAJOR GRID ── */
.major-grid {
  display:grid; grid-template-columns:repeat(auto-fit,minmax(210px,1fr));
  gap:14px; max-width:860px; width:100%;
  margin-bottom:36px; text-align:left;
}
.major-card {
  background:var(--surface); border:2px solid var(--border);
  border-radius:var(--radius); padding:26px 22px;
  cursor:pointer; transition:all .2s; position:relative; overflow:hidden;
}
.major-card::after {
  content:''; position:absolute; top:0;left:0;right:0; height:3px;
  background:var(--c,var(--accent)); transform:scaleX(0);
  transform-origin:left; transition:transform .22s;
}
.major-card:hover,.major-card.picked { border-color:var(--c,var(--accent)); background:var(--surface2); }
.major-card:hover::after,.major-card.picked::after { transform:scaleX(1); }
.tick {
  position:absolute; top:14px; right:14px;
  width:22px; height:22px; border-radius:50%;
  background:var(--c,var(--accent)); color:#060a12;
  font-size:11px; font-weight:700;
  display:none; align-items:center; justify-content:center;
}
.major-card.picked .tick { display:flex; }
.major-icon { font-size:30px; margin-bottom:14px; display:block; }
.major-name { font-family:'Syne',sans-serif; font-size:16px; font-weight:700; margin-bottom:6px; }
.major-desc { font-size:13px; color:var(--muted); line-height:1.5; }

/* ── INPUT ── */
.field { margin-bottom:24px; width:100%; max-width:420px; text-align:left; }
.field label { display:block; font-size:12px; color:var(--muted); text-transform:uppercase; letter-spacing:.08em; margin-bottom:8px; }
.field input {
  width:100%; background:var(--surface); border:1px solid var(--border);
  border-radius:8px; padding:13px 16px; color:var(--text);
  font-family:'DM Sans',sans-serif; font-size:15px; outline:none; transition:border-color .18s;
}
.field input:focus { border-color:var(--accent); }

/* ── TOP BAR ── */
.top-bar {
  position:sticky; top:0; z-index:50;
  background:rgba(8,12,24,.9); backdrop-filter:blur(14px);
  border-bottom:1px solid var(--border);
  padding:12px 28px; display:flex; align-items:center;
  justify-content:space-between; gap:16px;
}
.tb-name { font-family:'Syne',sans-serif; font-size:15px; font-weight:700; }
.tb-meta { font-size:12px; color:var(--muted); margin-top:2px; }
.mini-pills { display:flex; gap:12px; }
.mini-pill { text-align:center; }
.mini-pill-val { font-family:'Syne',sans-serif; font-size:17px; font-weight:700; }
.mini-pill-lbl { font-size:10px; color:var(--muted); text-transform:uppercase; letter-spacing:.06em; }

/* ── DECISION AREA ── */
.dec-inner { max-width:820px; margin:0 auto; padding:36px 24px 100px; width:100%; }
.prog-wrap { background:var(--surface); border-radius:100px; height:5px; overflow:hidden; margin-bottom:36px; }
.prog-fill { height:100%; background:linear-gradient(90deg,var(--accent),var(--blue)); border-radius:100px; transition:width .5s ease; }

.cat-header { display:flex; align-items:center; gap:16px; margin-bottom:28px; }
.cat-icon-box { width:52px; height:52px; border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:26px; flex-shrink:0; }
.cat-title { font-family:'Syne',sans-serif; font-size:26px; font-weight:800; }
.cat-desc { font-size:13px; color:var(--muted); margin-top:3px; }
.q-text { font-size:16px; font-weight:500; line-height:1.6; margin-bottom:24px; }

/* ── OPTIONS ── */
.opts-grid { display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-bottom:32px; }
@media(max-width:600px){.opts-grid{grid-template-columns:1fr}}
.opt-card {
  background:var(--surface); border:2px solid var(--border);
  border-radius:var(--radius); padding:22px;
  cursor:pointer; transition:all .2s; position:relative; user-select:none;
}
.opt-card:hover { border-color:var(--oc,var(--accent)); background:var(--surface2); }
.opt-card.chosen { border-color:var(--oc,var(--accent)); background:var(--surface2); }
.opt-card.chosen::after {
  content:'✓ Selected'; position:absolute; top:12px; right:12px;
  font-size:10px; font-weight:700; color:var(--oc,var(--accent));
  background:rgba(0,229,160,.1); padding:3px 9px; border-radius:100px;
}
.opt-letter {
  display:inline-flex; width:30px; height:30px; border-radius:7px;
  background:var(--surface2); border:1px solid var(--border);
  align-items:center; justify-content:center;
  font-family:'Syne',sans-serif; font-weight:700; font-size:13px;
  color:var(--muted); margin-bottom:12px; transition:all .18s;
}
.opt-card.chosen .opt-letter { background:var(--oc,var(--accent)); color:#060a12; border-color:transparent; }
.opt-card h4 { font-family:'Syne',sans-serif; font-size:14px; font-weight:700; margin-bottom:7px; }
.opt-card p  { font-size:13px; color:var(--muted); line-height:1.55; }
.ip { display:inline-block; margin-top:11px; font-size:10px; font-weight:700; padding:3px 9px; border-radius:100px; text-transform:uppercase; letter-spacing:.06em; }
.ip-h { background:rgba(0,229,160,.1);  color:var(--accent); }
.ip-m { background:rgba(59,130,246,.1); color:var(--blue); }
.ip-l { background:rgba(245,158,11,.1); color:var(--amber); }
.ip-r { background:rgba(236,72,153,.1); color:var(--pink); }

/* ── NAV ROW ── */
.nav-row { display:flex; align-items:center; justify-content:space-between; gap:12px; }
.step-lbl { font-size:13px; color:var(--muted); }

@keyframes slideR { from{opacity:0;transform:translateX(28px)} to{opacity:1;transform:translateX(0)} }
@keyframes slideL { from{opacity:0;transform:translateX(-28px)} to{opacity:1;transform:translateX(0)} }
.anim-r { animation:slideR .3s ease both; }
.anim-l { animation:slideL .3s ease both; }

/* ── RESULTS ── */
.res-inner { max-width:800px; margin:0 auto; padding:48px 24px 80px; width:100%; }
.score-card {
  background:var(--surface); border:1px solid var(--border);
  border-radius:16px; padding:48px 32px; text-align:center;
  margin-bottom:24px; position:relative; overflow:hidden;
}
.score-card::before {
  content:''; position:absolute; top:-60px; left:50%; transform:translateX(-50%);
  width:280px; height:280px;
  background:radial-gradient(circle,rgba(0,229,160,.07) 0,transparent 65%);
  pointer-events:none;
}
.score-big { font-family:'Syne',sans-serif; font-size:90px; font-weight:800; line-height:1; margin-bottom:8px; }
.score-sub { font-size:12px; color:var(--muted); text-transform:uppercase; letter-spacing:.1em; margin-bottom:22px; }
.r-pill { display:inline-flex; align-items:center; gap:8px; font-family:'Syne',sans-serif; font-size:18px; font-weight:700; padding:10px 26px; border-radius:100px; margin-bottom:18px; }
.score-verdict { font-size:15px; color:var(--muted); max-width:440px; margin:0 auto; line-height:1.65; }
.breakdown-grid { display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-bottom:24px; }
@media(max-width:580px){.breakdown-grid{grid-template-columns:1fr}}
.b-card { background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); padding:22px; }
.b-top { display:flex; align-items:center; gap:12px; margin-bottom:14px; }
.b-icon { font-size:22px; }
.b-name { font-family:'Syne',sans-serif; font-size:14px; font-weight:700; }
.b-choice { font-size:12px; color:var(--muted); margin-top:2px; }
.bar-bg { background:var(--surface2); border-radius:100px; height:7px; overflow:hidden; }
.bar-fg { height:100%; border-radius:100px; width:0; transition:width 1.1s ease; }
.bar-lbl { display:flex; justify-content:space-between; font-size:11px; color:var(--muted); margin-top:6px; }
.outcome-block { border-radius:var(--radius); padding:28px; margin-bottom:24px; }
.outcome-block h3 { font-family:'Syne',sans-serif; font-size:20px; font-weight:800; margin-bottom:10px; }
.outcome-block p  { font-size:14px; line-height:1.7; }
.tl-card { background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); padding:28px; margin-bottom:24px; }
.tl-card h3 { font-family:'Syne',sans-serif; font-size:17px; font-weight:700; margin-bottom:22px; }
.tl-steps { display:flex; flex-direction:column; }
.tl-step { display:flex; gap:18px; position:relative; }
.tl-step:not(:last-child)::after { content:''; position:absolute; left:14px; top:30px; bottom:-6px; width:2px; background:var(--border); }
.tl-dot { width:30px; height:30px; border-radius:50%; background:var(--surface2); border:2px solid var(--border); display:flex; align-items:center; justify-content:center; font-size:11px; flex-shrink:0; z-index:1; margin-top:2px; }
.tl-step.done .tl-dot { background:var(--accent); border-color:var(--accent); color:#060a12; font-weight:800; }
.tl-step.next .tl-dot { background:var(--blue); border-color:var(--blue); color:#fff; font-weight:800; }
.tl-body { padding-bottom:24px; }
.tl-body h4 { font-family:'Syne',sans-serif; font-size:14px; font-weight:700; margin-bottom:4px; }
.tl-body p  { font-size:13px; color:var(--muted); line-height:1.55; }
.res-footer { display:flex; gap:14px; flex-wrap:wrap; justify-content:center; padding-top:8px; }
</style>
</head>
<body>

<!-- ══════════ LANDING ══════════ -->
<section id="s-landing" class="screen show">
  <div class="live-badge">2025–2026 · Senior Cohort</div>
  <h1 class="hero-title">Are You<br><em>Job-Ready?</em></h1>
  <p class="hero-sub">GradReady simulates your final year of college. The choices you make across 4 key pillars determine your employment outcome at graduation.</p>
  <div class="stats-row">
    <div><div class="stat-num">73%</div><div class="stat-label">Grads feel unprepared</div></div>
    <div><div class="stat-num">4</div><div class="stat-label">Career pillars</div></div>
    <div><div class="stat-num">16</div><div class="stat-label">Decisions to make</div></div>
  </div>
  <button class="btn btn-green" onclick="goSetup()">Start Simulation →</button>
</section>

<!-- ══════════ SETUP ══════════ -->
<section id="s-setup" class="screen">
  <div class="sec-tag">Step 1 — Your Profile</div>
  <h2 class="sec-title" style="margin-bottom:32px">Tell Us About You</h2>

  <div class="field">
    <label for="inp-name">Your Name</label>
    <input id="inp-name" type="text" placeholder="e.g. Alex Johnson" autocomplete="off" />
  </div>

  <div class="sec-tag" style="margin-top:4px">Step 2 — Choose Your Major</div>
  <h2 class="sec-title" style="font-size:clamp(20px,3vw,32px);margin-bottom:24px">What Are You Studying?</h2>

  <div class="major-grid">
    <div class="major-card" style="--c:#00e5a0" data-major="cs" onclick="pickMajor(this)">
      <span class="tick">✓</span>
      <span class="major-icon">💻</span>
      <div class="major-name">Computer Science</div>
      <div class="major-desc">Software, data, AI/ML, systems — high demand across every industry.</div>
    </div>
    <div class="major-card" style="--c:#3b82f6" data-major="business" onclick="pickMajor(this)">
      <span class="tick">✓</span>
      <span class="major-icon">📊</span>
      <div class="major-name">Business / Finance</div>
      <div class="major-desc">Management, accounting, marketing, consulting, and financial services.</div>
    </div>
    <div class="major-card" style="--c:#f59e0b" data-major="engineering" onclick="pickMajor(this)">
      <span class="tick">✓</span>
      <span class="major-icon">⚙️</span>
      <div class="major-name">Engineering</div>
      <div class="major-desc">Mechanical, civil, electrical, chemical — technical and applied fields.</div>
    </div>
    <div class="major-card" style="--c:#ec4899" data-major="liberal" onclick="pickMajor(this)">
      <span class="tick">✓</span>
      <span class="major-icon">🎨</span>
      <div class="major-name">Liberal Arts / Design</div>
      <div class="major-desc">Communication, UX, media, psychology, sociology, creative arts.</div>
    </div>
  </div>

  <button id="begin-btn" class="btn btn-green off" onclick="beginSim()">Begin Senior Year →</button>
</section>

<!-- ══════════ DECISIONS ══════════ -->
<section id="s-decisions" class="screen">
  <div class="top-bar">
    <div>
      <div class="tb-name" id="tb-name">—</div>
      <div class="tb-meta" id="tb-meta">—</div>
    </div>
    <div class="mini-pills" id="mini-pills"></div>
  </div>
  <div class="dec-inner">
    <div class="prog-wrap"><div class="prog-fill" id="prog-fill" style="width:0%"></div></div>
    <div id="q-area"></div>
    <div class="nav-row">
      <button id="back-btn" class="btn btn-outline" onclick="prevCat()" style="display:none">← Back</button>
      <span class="step-lbl" id="step-lbl">1 of 4</span>
      <button id="next-btn" class="btn btn-green off" onclick="nextCat()">Next →</button>
    </div>
  </div>
</section>

<!-- ══════════ RESULTS ══════════ -->
<section id="s-results" class="screen">
  <div class="res-inner">
    <div style="text-align:center;margin-bottom:40px">
      <div class="sec-tag">Graduation Day — Your Outcome</div>
      <div class="sec-title">Employment Readiness Report</div>
    </div>
    <div class="score-card">
      <div class="score-big" id="r-score">—</div>
      <div class="score-sub">Overall Readiness Score / 100</div>
      <div class="r-pill" id="r-pill">—</div>
      <p class="score-verdict" id="r-verdict">—</p>
    </div>
    <div class="breakdown-grid" id="r-breakdown"></div>
    <div class="outcome-block" id="r-outcome">
      <h3 id="r-ot">—</h3><p id="r-op">—</p>
    </div>
    <div class="tl-card">
      <h3>Your 90-Day Post-Grad Plan</h3>
      <div class="tl-steps" id="r-tl"></div>
    </div>
    <div class="res-footer">
      <button class="btn btn-green" onclick="restart()">Try Again →</button>
      <button class="btn btn-outline" onclick="window.print()">📄 Save Report</button>
    </div>
  </div>
</section>

<script>
